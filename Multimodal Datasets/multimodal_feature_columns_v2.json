  "join": {
    "key": [
      "scenario_normalized (== network scenario)",
      "timestamp_s"
    ],
    "type": "exact one-to-one inner join",
    "scenario_normalization": "^DDOS_ -> DDOS",
    "network_key_source": "window_start_epoch_utc (Member 1's UTC epoch, validated, not modified)",
    "radio_key_source": "timestamp_s = floor(timestamp_ms / 1000) from radio_window_features_v2.csv",
    "sort_order": [
      "timestamp_s",
      "scenario",
      "window_id"
    ],
    "not_used": [
      "nearest-neighbour joins",
      "approximate joins",
      "fabricated rows",
      "imputation"
    ],
    "meaning": "second-level temporal alignment only; NOT packet-to-UE or flow-to-UE correspondence"
  },
  "identifiers": {
    "columns": [
      "window_id",
      "scenario",
      "radio_scenario",
      "radio_window_id"
    ]
  },
  "timestamps": {
    "columns": [
      "timestamp_s",
      "window_start_epoch_utc",
      "window_start_utc",
      "t_rel_s"
    ]
  },
  "labels": {
    "description": "Network labels (authoritative). Never model features. Radio-side labels are NOT carried.",
    "columns": [
      "family",
      "mode",
      "class_fm",
      "is_attack"
    ]
  },
  "diagnostics": {
    "description": "Network partial-window indicators and radio report counts. Never model features.",
